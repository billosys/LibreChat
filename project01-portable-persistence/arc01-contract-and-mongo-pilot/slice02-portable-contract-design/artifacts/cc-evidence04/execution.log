ile\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"ContentMetadata\",\"kind\":\"TypeAliasDeclaration\",\"start\":185,\"end\":185,\"sourceText\":\"export type ContentMetadata = Pick<PartMetadata, 'agentId' | 'groupId' | 'streamedIndex'>;\",\"properties\":[],\"literals\":[]},{\"file\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"ImageFile\",\"kind\":\"TypeAliasDeclaration\",\"start\":61,\"end\":79,\"sourceText\":\"export type ImageFile = TFile & {\\n  /**\\n   * The [File](https://platform.openai.com/docs/api-reference/files) ID of the image\\n   * in the message content.\\n   */\\n  file_id: string;\\n  filename: string;\\n  filepath: string;\\n  height: number;\\n  width: number;\\n  /**\\n   * Prompt used to generate the image if applicable.\\n   */\\n  prompt?: string;\\n  /**\\n   * Additional metadata used to generate or about the image/tool_call.\\n   */\\n  metadata?: Record<string, unknown>;\\n};\",\"properties\":[{\"path\":\"file_id\",\"name\":\"file_id\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":66,\"declaration\":\"file_id: string;\",\"branch\":\"root|intersection:1\"},{\"path\":\"filename\",\"name\":\"filename\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":67,\"declaration\":\"filename: string;\",\"branch\":\"root|intersection:1\"},{\"path\":\"filepath\",\"name\":\"filepath\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":68,\"declaration\":\"filepath: string;\",\"branch\":\"root|intersection:1\"},{\"path\":\"height\",\"name\":\"height\",\"type\":\"number\",\"expression\":null,\"optional\":false,\"line\":69,\"declaration\":\"height: number;\",\"branch\":\"root|intersection:1\"},{\"path\":\"width\",\"name\":\"width\",\"type\":\"number\",\"expression\":null,\"optional\":false,\"line\":70,\"declaration\":\"width: number;\",\"branch\":\"root|intersection:1\"},{\"path\":\"prompt\",\"name\":\"prompt\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"