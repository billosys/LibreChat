,{\"path\":\"tokenCount\",\"name\":\"tokenCount\",\"type\":\"number\",\"expression\":null,\"optional\":true,\"line\":203,\"declaration\":\"tokenCount?: number;\",\"branch\":\"root\"},{\"path\":\"summarizing\",\"name\":\"summarizing\",\"type\":\"boolean\",\"expression\":null,\"optional\":true,\"line\":204,\"declaration\":\"summarizing?: boolean;\",\"branch\":\"root\"},{\"path\":\"failed\",\"name\":\"failed\",\"type\":\"boolean\",\"expression\":null,\"optional\":true,\"line\":208,\"declaration\":\"failed?: boolean;\",\"branch\":\"root\"},{\"path\":\"initiatedBy\",\"name\":\"initiatedBy\",\"type\":\"'user'\",\"expression\":null,\"optional\":true,\"line\":211,\"declaration\":\"initiatedBy?: 'user';\",\"branch\":\"root\"},{\"path\":\"summaryVersion\",\"name\":\"summaryVersion\",\"type\":\"number\",\"expression\":null,\"optional\":true,\"line\":212,\"declaration\":\"summaryVersion?: number;\",\"branch\":\"root\"},{\"path\":\"model\",\"name\":\"model\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"line\":213,\"declaration\":\"model?: string;\",\"branch\":\"root\"},{\"path\":\"provider\",\"name\":\"provider\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"line\":214,\"declaration\":\"provider?: string;\",\"branch\":\"root\"},{\"path\":\"createdAt\",\"name\":\"createdAt\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"line\":215,\"declaration\":\"createdAt?: string;\",\"branch\":\"root\"},{\"path\":\"boundary\",\"name\":\"boundary\",\"type\":\"{\\n    messageId: string;\\n    contentIndex: number;\\n  }\",\"expression\":null,\"optional\":true,\"line\":216,\"declaration\":\"boundary?: {\\n    messageId: string;\\n    contentIndex: number;\\n  };\",\"branch\":\"root\"},{\"path\":\"boundary.messageId\",\"name\":\"messageId\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":217,\"declaration\":\"messageId: string;\",\"branch\":\"root\"},{\"path\":\"boundary.contentIndex\",\"name\":\"contentIndex\",\"type\":\"number\",\"expression\":null,\"optional\":false,\"line\":218,\"declaration\":\"contentIndex: number;\",\"branch\":\"root\"}],\"literals\":[]},{\"file\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"SteerContentPart\",\"kind\":\"TypeAliasDeclaration\",\"start\":228,\"end\":242,\"sourceText\":\"export type SteerContentPart = {\\n  type: ContentTypes.STEER;\\n  steer: string;\\n  steerId?: string;\\n  /** Stable optimistic-client id used to settle a POST whose response was lost. */\\n  clientSteerId?: string;\\n  createdAt?: number;\\n  /** Attachments steered with the message; re-encoded per turn on replay\\n   *  like any other user-message media (refs only, never encoded data). */\\n  files?: Partial<TFile>[];\\n  /** Quoted excerpts steered with the message, persisted separately from the\\n   *  typed text (mirroring `TMessage.quotes`) so the UI renders them as\\n   *  reference blocks; merged into the model-bound user turn on every replay. */\\n  quotes?: string[];\\n};\",\"properties\":[{\"path\":\"type\",\"name\":\"type\",\"type\":\"ContentTypes.STEER\",\"expression\":null,\"optional\":false,\"line\":229,\"declaration\":\"type: ContentTypes.STEER;\",\"branch\":\"root\"},{\"path\":\"steer\",\"name\":\"steer\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":230,\"declaration\":\"steer: string;\",\"branch\":\"root\"},{\"path\":\"steerId\",\"name\":\"steerId\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"line\":231,\"declaration\":\"steerId?: string;\",\"branch\":\"root\"},{\"path\":\"clientSteerId\",\"name\":\"clientSteerId\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"line\":233,\"declaration\":\"clientSteerId?: string;\",\"branch\":\"root\"},{\"path\":\"createdAt\",\"name\":\"createdAt\",\"type\":\"number\",\"expression\":null,\"optional\":true,\"line\":234,\"declaration\":\"createdAt?: number;\",\"branch\":\"root\"},{\"path\":\"files\",\"name\":\"files\",\"type\":\"Partial<TFile>[]\",\"expression\":null,\"optional\":true,\"line\":237,\"declaration\":\"files?: Partial<TFile>[];\",\"branch\":\"root\"},{\"path\":\"quotes\",\"name\":\"quotes\",\"type\":\"string[]\",\"expression\":null,\"optional\":true,\"line\":241,\"declaration\":\"quotes?: string[];\",\"branch\":\"root\"}],\"literals\":[]},{\"file\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"TMessageContentParts\",\"kind\":\"TypeAliasDeclaration\",\"start\":244,\"end\":315,\"sourceText\":\"export type TMessageContentParts =\\n  | ({\\n      type: ContentTypes.ERROR;\\n      text?: string | TextData;\\n      error?: string;\\n      /** Set when this failure is what a manual compaction produced instead of a\\n       *  summary. The turn has no other record of having been one, so the rerun\\n       *  controls read it the same way they read a summary's marker. */\\n      initiatedBy?: 'user';\\n    } & ContentMetadata)\\n  | ({\\n      type: ContentTypes.THINK;\\n      think?: string | TextData;\\n      /** Generated orientation for this user-visible reasoning step. */\\n      reasoning_label?: string;\\n      /** Stable SDK run-step identity used to correlate live revisions. */\\n      reasoning_label_step_id?: string;\\n      /** Durable provider-call count used to enforce the per-run cost cap across resumes. */\\n      reasoning_label_attempts?: number;\\n      /** Visible reasoning length included in this step's latest provider call. */\\n      reasoning_label_submitted_chars?: number;\\n      /** Monotonic provider-call revision; gaps are allowed after unsuccessful attempts. */\\n      reasoning_label_revision?: number;\\n      /** Whether the reasoning step can still produce a newer label. */\\n      reasoning_label_status?: 'streaming' | 'complete';\\n      /** The reasoning happened but its text is not available to this view\\n       *  (e.g. detached subagent projections retain only a marker). */\\n      reasoning_unavailable?: boolean;\\n    } & ContentMetadata)\\n  | (SteerContentPart & ContentMe