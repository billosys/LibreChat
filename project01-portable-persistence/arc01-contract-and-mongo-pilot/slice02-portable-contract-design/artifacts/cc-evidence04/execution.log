ation\":\"file_id: string;\",\"branch\":\"root\"},{\"path\":\"quote\",\"name\":\"quote\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":92,\"declaration\":\"quote: string;\",\"branch\":\"root\"}],\"literals\":[]},{\"file\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"FilePath\",\"kind\":\"TypeAliasDeclaration\",\"start\":95,\"end\":101,\"sourceText\":\"export type FilePath = {\\n  end_index: number;\\n  file_path: FilePathDetails;\\n  start_index: number;\\n  text: string;\\n  type: 'file_path';\\n};\",\"properties\":[{\"path\":\"end_index\",\"name\":\"end_index\",\"type\":\"number\",\"expression\":null,\"optional\":false,\"line\":96,\"declaration\":\"end_index: number;\",\"branch\":\"root\"},{\"path\":\"file_path\",\"name\":\"file_path\",\"type\":\"FilePathDetails\",\"expression\":null,\"optional\":false,\"line\":97,\"declaration\":\"file_path: FilePathDetails;\",\"branch\":\"root\"},{\"path\":\"start_index\",\"name\":\"start_index\",\"type\":\"number\",\"expression\":null,\"optional\":false,\"line\":98,\"declaration\":\"start_index: number;\",\"branch\":\"root\"},{\"path\":\"text\",\"name\":\"text\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":99,\"declaration\":\"text: string;\",\"branch\":\"root\"},{\"path\":\"type\",\"name\":\"type\",\"type\":\"'file_path'\",\"expression\":null,\"optional\":false,\"line\":100,\"declaration\":\"type: 'file_path';\",\"branch\":\"root\"}],\"literals\":[]},{\"file\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"FilePathDetails\",\"kind\":\"TypeAliasDeclaration\",\"start\":103,\"end\":105,\"sourceText\":\"export type FilePathDetails = {\\n  file_id: string;\\n};\",\"properties\":[{\"path\":\"file_id\",\"name\":\"file_id\",\"type\":\"string\",\"expression\":null,\"optional\":false,\"line\":104,\"declaration\":\"file_id: string;\",\"branch\":\"root\"}],\"literals\":[]},{\"file\":\"packages/data-provider/src/types/content.ts\",\"symbol\":\"Text\",\"kind\":\"Type