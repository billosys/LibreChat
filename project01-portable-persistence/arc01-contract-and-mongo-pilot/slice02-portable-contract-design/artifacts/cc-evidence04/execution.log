t\",\"type\":null,\"expression\":\"z.string().max(1024).optional()\",\"optional\":true,\"line\":114,\"declaration\":\"text: z.string().max(1024).optional()\",\"branch\":\"zod-object\"}],\"literals\":[\"Feedback tag does not match rating\",\"tag\"]},{\"file\":\"packages/data-provider/src/feedback.ts\",\"symbol\":\"TFeedback\",\"kind\":\"TypeAliasDeclaration\",\"start\":129,\"end\":133,\"sourceText\":\"export type TFeedback = {\\n  rating: TFeedbackRating;\\n  tag: TFeedbackTag | undefined;\\n  text?: string;\\n};\",\"properties\":[{\"path\":\"rating\",\"name\":\"rating\",\"type\":\"TFeedbackRating\",\"expression\":null,\"optional\":false,\"line\":130,\"declaration\":\"rating: TFeedbackRating;\",\"branch\":\"root\"},{\"path\":\"tag\",\"name\":\"tag\",\"type\":\"TFeedbackTag | undefined\",\"expression\":null,\"optional\":false,\"line\":131,\"declaration\":\"tag: TFeedbackTag | undefined;\",\"branch\":\"root\"},{\"path\":\"text\",\"name\":\"text\",\"type\":\"string\",\"expression\":null,\"optional\":true,\"line\":132,\"declaration\":\"text?: string;\",\"branch\":\"root\"}],\"literals\":[]},{\"file\":\"packages/data-provider/src/types.ts\",\"symbol\":\"CodeWorkspaceSelection\",\"missing\":true},{\"file\":\"packages/data-provider/src/schemas.ts\",\"symbol\":\"agentFadingTierSchema\",\"kind\":\"VariableDeclaration\",\"start\":879,\"end\":883,\"sourceText\":\"agentFadingTierSchema = z.object({\\n  v: z.literal(1),\\n  budgetTokens: z.number().positive(),\\n  masked: z.boolean(),\\n})\",\"properties\":[{\"path\":\"v\",\"name\":\"v\",\"type\":null,\"expression\":\"z.literal(1)\",\"optional\":false,\"line\":880,\"declaration\":\"v: z.literal(1)\",\"branch\":\"zod-object\"},{\"path\":\"budgetTokens\",\"name\":\"budgetTokens\",\"type\":null,\"expression\":\"z.number().positive()\",\"optional\":false,\"line\":881,\"declaration\":\"budgetTokens: z.number().positive()\",\"branch\":\"zod-object\"},{\"path\":\"masked\",\"name\":\"masked\",\"type\":null,\"expression\":\"z.boolean()\",