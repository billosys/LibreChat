,\\n      index: true,\\n    }\",\"interfaceType\":\"string\",\"provider\":null,\"defaultRead\":\"included\",\"portableServerRead\":\"preserve field and presence\",\"publicRead\":\"not in pilot public conversation scope\",\"endpointUnsetRule\":\"undefined option may unset existing key\"},{\"name\":\"pinned\",\"source\":{\"file\":\"packages/data-schemas/src/schema/convo.ts\",\"line\":378},\"storageDefinition\":\"{\\n      type: Boolean,\\n    }\",\"interfaceType\":\"boolean\",\"provider\":{\"name\":\"pinned\",\"definition\":\"z.boolean().optional()\",\"line\":1122},\"defaultRead\":\"included\",\"portableServerRead\":\"preserve field and presence\",\"publicRead\":\"not in pilot public conversation scope\",\"endpointUnsetRule\":\"excluded from unset enumeration\"},{\"name\":\"archivedAt\",\"source\":{\"file\":\"packages/data-schemas/src/schema/convo.ts\",\"line\":385},\"storageDefinition\":\"{\\n      type: Date,\\n    }\",\"interfaceType\":\"Date | null\",\"provider\":{\"name\":\"archivedAt\",\"definition\":\"z.string().nullable().optional()\",\"line\":1121},\"defaultRead\":\"included\",\"portableServerRead\":\"preserve field and presence\",\"publicRead\":\"not in pilot public conversation scope\",\"endpointUnsetRule\":\"excluded from unset enumeration\"}],\"providerOnly\":[\"isShared\",\"userLabel\",\"parentMessageId\",\"stream\",\"artifacts\",\"context\",\"createdAt\",\"updatedAt\",\"thinkingDisplay\",\"additionalModelRequestFields\",\"additional_instructions\",\"append_current_datetime\",\"presetOverride\"],\"interfaceOnly\":[\"isShared\",\"createdAt\",\"updatedAt\"],\"implicit\":{\"createdAt\":\"timestamp; preserve Date locally and string at HTTP serialization\",\"updatedAt\":\"timestamp; preserve Date locally and string at HTTP serialization\",\"_id\":\"adapter-private; omit from portable record\",\"__v\":\"adapter-private; omit from portable record\"}}\n",
